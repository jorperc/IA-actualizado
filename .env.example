# ==========================================
# AI WEEKLY RADAR - VARIABLES DE ENTORNO
# ==========================================

# GEMINI_API_KEY: Requerida para las llamadas a Gemini y Google Search Grounding.
# En Google AI Studio se inyecta automáticamente.
# En Cloud Run, configúrala como Secret o variable de entorno.
GEMINI_API_KEY="AIzaSy..."

# APP_URL: URL pública donde está alojada la aplicación.
# En AI Studio o Cloud Run es la URL del servicio.
APP_URL="https://ai-weekly-radar-xyz.a.run.app"

# SCHEDULER_SECRET: Token de seguridad para proteger el endpoint POST /api/weekly-report
# Cloud Scheduler debe enviar este token en el header: Authorization: Bearer <SCHEDULER_SECRET>
SCHEDULER_SECRET="ai-radar-secret-key-2026"

# CONFIGURACIÓN OPCIONAL DE SERVIDOR SMTP PARA ENVÍO DE EMAIL
# También se puede configurar directamente desde la pestaña de Configuración en la interfaz.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="tu_contrasena_de_aplicacion"
SMTP_FROM="AI Weekly Radar <tucorreo@gmail.com>"
